{
  "name": "ai-chat-spell-assistant",
  "displayName": "AI Chat Spell Assistant",
  "description": "Intelligent spell & prompt corrector for AI coding assistant chats (Copilot, Claude, ChatGPT, Antigravity). Instant auto-fix & interactive review.",
  "version": "0.6.1",
  "publisher": "ibrahim-adel",
  "icon": "assets/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ibrahimadel000/vscode-prompt-spell-checker"
  },
  "bugs": {
    "url": "https://github.com/ibrahimadel000/vscode-prompt-spell-checker/issues"
  },
  "homepage": "https://github.com/ibrahimadel000/vscode-prompt-spell-checker#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "spell",
    "spellcheck",
    "typo",
    "ai",
    "chat",
    "copilot",
    "codex",
    "antigravity",
    "prompt",
    "grammar"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "spellAssistant.quickFixWord",
        "title": "Quick Fix Typos at Cursor (Suggestions Menu)",
        "category": "Spell Assistant",
        "icon": "$(sparkle)"
      },
      {
        "command": "spellAssistant.openPromptChecker",
        "title": "Open Prompt Spell Checker (Interactive Text Box)",
        "category": "Spell Assistant",
        "icon": "$(sparkle)"
      },
      {
        "command": "spellAssistant.quickFixAndCopy",
        "title": "✨ AI Fix & Paste Prompt",
        "category": "Spell Assistant",
        "icon": "$(sparkle)"
      },
      {
        "command": "spellAssistant.scanDocument",
        "title": "Scan Document for Typos",
        "category": "Spell Assistant"
      },
      {
        "command": "spellAssistant.quickFixAll",
        "title": "Quick Fix All Typos in Editor",
        "category": "Spell Assistant"
      },
      {
        "command": "spellAssistant.toggle",
        "title": "Toggle Spell Checking",
        "category": "Spell Assistant"
      },
      {
        "command": "spellAssistant.addWord",
        "title": "Add Word to Dictionary",
        "category": "Spell Assistant"
      },
      {
        "command": "spellAssistant.aiProofread",
        "title": "AI Predict & Proofread Prompt",
        "category": "Spell Assistant",
        "icon": "$(sparkle)"
      },
      {
        "command": "spellAssistant.contactDeveloper",
        "title": "Contact Developer / Report an Issue",
        "category": "Spell Assistant",
        "icon": "$(mail)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "spellAssistant.openPromptChecker",
          "group": "1_modification@1"
        },
        {
          "command": "spellAssistant.quickFixAndCopy",
          "when": "editorHasSelection",
          "group": "1_modification@2"
        },
        {
          "command": "spellAssistant.quickFixAll",
          "group": "1_modification@3"
        }
      ],
      "editor/title": [
        {
          "command": "spellAssistant.openPromptChecker",
          "group": "navigation",
          "when": "true"
        }
      ]
    },
    "keybindings": [
      {
        "command": "spellAssistant.quickFixWord",
        "key": "alt+q"
      },
      {
        "command": "spellAssistant.openPromptChecker",
        "key": "ctrl+alt+s"
      },
      {
        "command": "spellAssistant.openPromptChecker",
        "key": "shift+alt+q"
      },
      {
        "command": "spellAssistant.quickFixAndCopy",
        "key": "alt+w"
      },
      {
        "command": "spellAssistant.aiProofread",
        "key": "alt+e"
      }
    ],
    "configuration": {
      "title": "AI Chat Spell Assistant",
      "properties": {
        "spellAssistant.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable spell checking."
        },
        "spellAssistant.checkOnType": {
          "type": "boolean",
          "default": true,
          "description": "Check spelling in real-time as you type in documents."
        },
        "spellAssistant.debounceMs": {
          "type": "number",
          "default": 300,
          "description": "Delay in ms before checking after typing."
        },
        "spellAssistant.extraKnownWords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional words to treat as correctly spelled."
        },
        "spellAssistant.targetLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "markdown",
            "plaintext",
            "git-commit",
            "scminput"
          ],
          "description": "Language IDs of documents to spell-check."
        },
        "spellAssistant.ignoreCamelCase": {
          "type": "boolean",
          "default": true,
          "description": "Skip camelCase and snake_case identifiers."
        },
        "spellAssistant.ignoreCodeBlocks": {
          "type": "boolean",
          "default": true,
          "description": "Skip fenced and inline code blocks."
        },
        "spellAssistant.ignoreUrls": {
          "type": "boolean",
          "default": true,
          "description": "Skip URLs and email addresses."
        },
        "spellAssistant.ignoreFilePaths": {
          "type": "boolean",
          "default": true,
          "description": "Skip file paths."
        },
        "spellAssistant.ignoreAllCaps": {
          "type": "boolean",
          "default": true,
          "description": "Skip ALL_CAPS words."
        },
        "spellAssistant.maxSuggestions": {
          "type": "number",
          "default": 5,
          "description": "Maximum number of suggestions to show."
        },
        "spellAssistant.diagnosticSeverity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information"
          ],
          "default": "error",
          "description": "Visual style for typos in editor tabs: 'error' (red squiggly line), 'warning' (yellow squiggly line), or 'information' (subtle dots)."
        },
        "spellAssistant.aiProofreader.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI predictive proofreader (Tier 2) to fix complex grammar, slang, and malapropisms."
        },
        "spellAssistant.aiProofreader.provider": {
          "type": "string",
          "enum": [
            "auto",
            "vscode-lm",
            "languagetool",
            "custom-llm"
          ],
          "default": "auto",
          "description": "AI Proofreader provider: 'auto' (tries vscode.lm then LanguageTool), 'vscode-lm' (uses IDE native AI model), 'languagetool' (uses LanguageTool grammar API), or 'custom-llm' (custom OpenAI/Ollama endpoint)."
        },
        "spellAssistant.aiProofreader.customEndpoint": {
          "type": "string",
          "default": "",
          "description": "Optional custom LLM endpoint URL (e.g. 'http://localhost:11434/v1/chat/completions' for Ollama, or 'https://api.groq.com/openai/v1/chat/completions')."
        },
        "spellAssistant.aiProofreader.customApiKey": {
          "type": "string",
          "default": "",
          "description": "Optional API key for custom LLM endpoint (Groq / OpenAI)."
        },
        "spellAssistant.aiProofreader.customModel": {
          "type": "string",
          "default": "llama-3.3-70b-versatile",
          "description": "Model identifier for custom LLM endpoint."
        },
        "spellAssistant.aiProofreader.languageToolEndpoint": {
          "type": "string",
          "default": "https://api.languagetool.org/v2/check",
          "description": "LanguageTool REST API endpoint (defaults to official public API or self-hosted server)."
        },
        "spellAssistant.targetChat": {
          "type": "string",
          "enum": [
            "auto",
            "codex",
            "antigravity",
            "copilot"
          ],
          "enumDescriptions": [
            "Automatically detect target chat (prioritizes Codex if installed, then Antigravity / Copilot)",
            "OpenAI Codex Chat (chatgpt.sidebarView)",
            "Antigravity Agent Chat",
            "GitHub Copilot / VS Code Chat"
          ],
          "default": "auto",
          "description": "Choose which AI Chat to paste into when using \"Fix & Paste to Chat\" in the Prompt Inspector."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node test/benchmark.test.js",
    "package": "npx @vscode/vsce package",
    "publish:marketplace": "npx @vscode/vsce publish",
    "publish:ovsx": "npx ovsx publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "nspell": "^2.1.5",
    "dictionary-en": "^4.0.0"
  }
}
